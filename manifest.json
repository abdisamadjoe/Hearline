{
  "manifest_version": 3,
  "name": "Hearline — Any page, read aloud.",
  "version": "1.0",
  "description": "Read any page aloud with real-time highlighting and RSVP speed reading",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "injected.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-hearline": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "Toggle Hearline"
    }
  }
}